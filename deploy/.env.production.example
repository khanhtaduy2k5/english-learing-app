# =============================================================================
# PRODUCTION Environment Variables — English Learning App
# =============================================================================
# USAGE:
#   1. Copy this file:  cp .env.production.example .env.production
#   2. Fill in real values below
#   3. Upload to server: scp .env.production deploy@157.230.37.27:/opt/english-app/
#   4. NEVER commit .env.production to Git!
# =============================================================================

# ── Docker Hub ───────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=khanhtaduy2k5

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=learnenglish1.me

# ── Spring Boot (Server) ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (Supabase Pooler - Khuyên dùng cổng 5432 hoặc 6543 của pooler để tương thích IPv4)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<your-project-id>
SPRING_DATASOURCE_PASSWORD=<db_password>

# Redis Cloud
SPRING_DATA_REDIS_HOST=redis-15530.crce185.ap-seast-1-1.ec2.cloud.redislabs.com
SPRING_DATA_REDIS_PORT=15530
SPRING_DATA_REDIS_PASSWORD=<redis_cloud_password>

# Groq AI
GROQ_API_KEY=<your_groq_api_key>

# JWT Secret (generate a strong random string, at least 64 chars)
# openssl rand -base64 64
JWT_SECRET=<generate_a_strong_random_secret_here>

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Used at Docker build time for client-side JS bundle
NEXT_PUBLIC_API_BASE_URL=https://learnenglish1.me
